# Copy the REVERB_APP_KEY value from backend/.env
VITE_REVERB_APP_KEY=
# Dev (Reverb on :8080):    VITE_REVERB_HOST=localhost  VITE_REVERB_PORT=8080  VITE_REVERB_SCHEME=http
# Production (behind nginx): leave HOST/PORT empty, VITE_REVERB_SCHEME=https
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# Optional: base URL encoded in the QR codes (defaults to the current site)
VITE_PUBLIC_URL=
